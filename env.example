# ============================================================
# Скопируйте этот файл в .env.local и заполните значения.
# .env.local НИКОГДА не попадает в git (см. .gitignore).
# Значения берутся из Supabase → Settings → API и других сервисов.
# ============================================================

# --- Supabase (Settings → API в панели проекта) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Карта: MapTiler (бесплатный тариф, maptiler.com → Account → Keys) ---
NEXT_PUBLIC_MAPTILER_KEY=

# --- Капча: Cloudflare Turnstile (бесплатно; понадобится с Фазы 6) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Платежи: Stripe (понадобится только с Фазы 10) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Примечание: ключи Google OAuth настраиваются в панели Supabase
# (Authentication → Providers → Google) — отдельные переменные здесь не нужны.
